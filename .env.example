# Copy to .env at repo root. Use this file as the single checklist for all keys.
# Local: fill in values here. Production: add same keys to Azure (Container App / Web App) or GitHub secrets.
# See docs/Env_Files_Where_to_Edit.md for the "add a new key" workflow.

# --- Required for Docker (API) ---
DATABASE_URL=postgresql://lifebook:lifebook@db:5432/lifebook?sslmode=disable
APP_ENV=local
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Session / auth (required in any non-local environment) ---
# Used to sign HS256 JWT session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=dev-lifebook-secret-change-me
SESSION_COOKIE_NAME=lb_session
SESSION_TTL_DAYS=30

# Public web origin used in password-reset emails/links
PUBLIC_APP_URL=http://localhost:3000

# Optional SMTP for password-reset emails. If unset and APP_ENV=local,
# POST /auth/forgot-password returns a `dev_reset_url` you can open in the browser.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=LifeBook <noreply@example.com>
# SMTP_USE_TLS=true

# --- Optional: features (set in .env for local; add to Azure for production) ---
# Voice / agents (Talk Realtime, story titles, BGM mood, library labels, TTS fallback)
OPENAI_API_KEY=
# Optional shared fallback for text roles when a role-specific var is unset
# OPENAI_TEXT_MODEL=gpt-5.6-terra
# Per-agent overrides (defaults in services/api/app/core/openai_models.py):
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1          # Agent 1 Conversation (voice shell for 1–3)
# OPENAI_STORYTELLER_MODEL=gpt-5.6                # Agent 2 titles / story craft
# OPENAI_CURATOR_MODEL=gpt-5.6-terra              # Agent 3 BGM / music prompts
# OPENAI_CURATOR_TTS_MODEL=gpt-4o-mini-tts        # Agent 3 OpenAI TTS fallback
# OPENAI_CONTENT_MANAGER_MODEL=gpt-5.6-luna       # Agent 4 recall labels / tags
# OPENAI_CHIEF_OF_STAFF_MODEL=gpt-5.6-terra       # Agent 5 prefs / routing text
# Narration with the user's cloned voice, plus optional unique BGM (ElevenLabs Music credits)
ELEVENLABS_API_KEY=

# Azure Blob (uploads, photos, audio)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_AUDIO=audio
AZURE_STORAGE_SAS_TTL_MINUTES=15
AZURE_STORAGE_READ_SAS_TTL_MINUTES=60
