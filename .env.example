# Copy to .env at repo root. Use this file as the single checklist for all keys.
# Local: fill in values here. Production: add same keys to Azure (Container App / Web App) or GitHub secrets.
# See docs/Env_Files_Where_to_Edit.md for the "add a new key" workflow.

# --- Required for Docker (API) ---
DATABASE_URL=postgresql://lifebook:lifebook@db:5432/lifebook?sslmode=disable
APP_ENV=local
CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Session / auth (required in any non-local environment) ---
# Used to sign HS256 JWT session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_SECRET=dev-lifebook-secret-change-me
SESSION_COOKIE_NAME=lb_session
SESSION_TTL_DAYS=30

# --- Optional: features (set in .env for local; add to Azure for production) ---
# Voice (Talk, Realtime)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
# Narration with the user's cloned voice, plus optional BGM (ElevenLabs)
ELEVENLABS_API_KEY=

# Azure Blob (uploads, photos, audio)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_AUDIO=audio
AZURE_STORAGE_SAS_TTL_MINUTES=15
AZURE_STORAGE_READ_SAS_TTL_MINUTES=60
